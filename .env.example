NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only: configure in the hosting provider's encrypted secrets.
# Vercel: production env only. Cloudflare: Worker runtime secret only.
# Never use NEXT_PUBLIC_ for this key or put it in build variables.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Verified email allowed to initialize the owner. No first-visitor ownership.
STUDIO_OWNER_EMAIL=owner@example.com
# Exact origin for write requests. Set separately for each hosting provider.
# APP_ORIGIN=https://studio-hub.example.com

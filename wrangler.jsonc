{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-hub",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "account_id": "0d13e432203561afb28aaf4719d8ffd3",
  "workers_dev": true,
  "preview_urls": false
}
